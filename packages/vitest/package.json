{
  "name": "@weapp-container/vitest",
  "version": "0.1.0",
  "type": "module",
  "description": "Vite artifact plugin and isolated Vitest fixtures for Weapp Container",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "@weapp-container/node": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=5.0.0"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-container/weapp-container.git",
    "directory": "packages/vitest"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tsdown.config.ts",
    "test:types": "tsd --files test-d/**/*.test-d.ts",
    "test": "node --test test/integration.test.mjs"
  },
  "tsd": {
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "skipLibCheck": true
    }
  }
}
