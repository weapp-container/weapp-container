{
  "name": "@weapp-container/node",
  "version": "0.1.0",
  "type": "module",
  "description": "Isolated real-runtime mini-program integration testing",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./artifact": {
      "import": {
        "types": "./dist/artifact.d.mts",
        "default": "./dist/artifact.mjs"
      },
      "require": {
        "types": "./dist/artifact.d.cts",
        "default": "./dist/artifact.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dependencies": {
    "@sonofmagic/container-manifest": "workspace:*"
  },
  "optionalDependencies": {
    "@weapp-container/runtime-darwin-arm64": "workspace:*",
    "@weapp-container/runtime-linux-x64": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "weapp-vite": ">=7.5.0"
  },
  "peerDependenciesMeta": {
    "weapp-vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "weapp-vite": "7.5.0"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-container/weapp-container.git",
    "directory": "packages/node"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tsdown.config.ts",
    "test:types": "tsd --files test-d/**/*.test-d.ts",
    "test": "node --test test/*.test.mjs"
  },
  "tsd": {
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "skipLibCheck": true
    }
  }
}
