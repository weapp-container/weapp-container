# The Harmony sample needs these DevEco project descriptors for a clean HAP
# build. Keep generated Hvigor state and build outputs ignored.
!examples/hosts/harmony/hvigor/
!examples/hosts/harmony/hvigor/hvigor-config.json5
!examples/hosts/harmony/entry/build-profile.json5

# Reviewed portable formatting packages are source inputs, including dist and nested dependencies.
!conformance/recipes/template-format-dependencies/**/
!conformance/recipes/template-format-dependencies/**

# Reviewed producer provenance is an immutable fixture input, including logs.
!scripts/fixtures/reviewed-producers/**/provenance/*.log

# Local build state, credentials and private signing material.
.gradle/
.hvigor/
local.properties
.env
.env.*
!.env.example
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
# Historical validation output belongs in private archives, outside source Git.
docs/**/evidence/
docs/*-evidence/
docs/sdk-migration/
examples/hosts/conformance-web/projection-build.json

# Generated npm testing runtime payloads
packages/runtime/*/bin/
packages/runtime/*/runtime.json
packages/runtime/*/RUNTIME-LICENSE
packages/runtime/*/THIRD_PARTY_NOTICES
packages/**/node_modules/
packages/**/test/.tmp-*/
packages/**/.weapp-vite/

# repoctl / TypeScript local build state
/tools/**/node_modules/
*.tsbuildinfo

# Local instructions and private validation state.
/AGENTS.md
/.local-validation/
/artifacts/local-validation/
