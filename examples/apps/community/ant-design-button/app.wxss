page {
  min-height: 100%;
  background-color: #f5f5f5;
  color: #333333;
  font-family: sans-serif;
}

.demo-page {
  padding: 20px;
}

.demo-title {
  margin: 4px 0 8px;
  font-size: 22px;
  font-weight: 600;
}

.demo-description {
  margin-bottom: 20px;
  color: #66717c;
  font-size: 14px;
}

.demo-section {
  margin-bottom: 22px;
}

.demo-section-title {
  margin-bottom: 12px;
  color: #4f5b66;
  font-size: 14px;
}

.demo-button {
  margin-bottom: 10px;
}

.demo-status {
  min-height: 24px;
  margin-top: 6px;
  color: #536372;
  font-size: 13px;
}
