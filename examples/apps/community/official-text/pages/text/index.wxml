<view class="page">
  <view class="page-heading">微信官方文本组件示例</view>
  <scroll-view class="text-box" scroll-y scroll-top="{{scrollTop}}">
    <block wx:for="{{extraLine}}" wx:key="index">
      <text class="text-line">{{item}}</text>
    </block>
    <text wx:if="{{!extraLine.length}}" class="empty-state">点击添加一行示例文本</text>
  </scroll-view>
  <view class="actions">
    <button disabled="{{!canAdd}}" bindtap="add">添加一行</button>
    <button disabled="{{!canRemove}}" bindtap="remove">移除最后一行</button>
  </view>
</view>
