<view id="dual-renderer-skia" class="screen">
  <view class="kicker">Skia / CanvasKit</view>
  <view class="title">切换到 Skia 画面</view>
  <view id="instance" class="meta instance">实例 {{instance}} · ready {{readyCount}} · 显示 {{showCount}}</view>
  <view id="shared" class="meta shared">共享点击 {{sharedTaps}} · App 时钟 {{ticks}} s</view>
  <view id="timer" class="meta timer">timer #{{timerId}} · App 启动 {{launches}} 次</view>
  <view id="session" class="meta token">{{token}}</view>
  <view id="count" class="counter" style="background:{{color}}">当前页面计数：{{count}}</view>
  <view id="increment" class="button increment" bindtap="increment">当前页 +1，同时写入共享存储</view>
  <view id="back" class="button navigate" bindtap="back">返回保留的 DOM 页面</view>
  <view id="to-return" class="button secondary" bindtap="toReturn">替换为新的 DOM 页面</view>
  <view id="refresh" class="button refresh" bindtap="refresh">刷新共享存储与时钟</view>
  <view class="hint">返回会恢复首个 DOM 页面；替换会销毁当前 Skia 页，再创建第三页。AppService、存储和时钟继续共享。</view>
  <view id="last-event" class="trace">最近生命周期：{{lastEvent}}</view>
</view>
