.title { position: absolute; left: 20px; top: 42px; width: 335px; height: 32px; font-size: 24px; font-weight: bold; }
.meta { position: absolute; left: 20px; width: 335px; height: 22px; font-size: 13px; }
.instance { top: 90px; }
.shared { top: 116px; }
.timer { top: 142px; }
.token { top: 168px; font-size: 11px; color: #52627a; }
.counter { position: absolute; left: 20px; top: 202px; width: 335px; height: 40px; line-height: 40px; color: white; text-align: center; border-radius: 6px; }
.button { position: absolute; left: 20px; width: 335px; height: 44px; line-height: 44px; background: #243f75; color: white; text-align: center; border-radius: 6px; }
.increment { top: 262px; }
.navigate { top: 316px; }
.secondary { top: 370px; }
.refresh { top: 424px; background: #dde5f0; color: #172b4d; }
