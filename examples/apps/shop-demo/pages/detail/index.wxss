.product-detail {
  padding: 32rpx;
}

.detail-image {
  display: block;
  width: 100%;
  height: 460rpx;
  padding: 32rpx;
  background: #e7eee9;
}

.detail-title {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
}

.detail-price {
  display: block;
  margin-top: 18rpx;
  color: #e56b58;
  font-size: 34rpx;
  font-weight: 700;
}

.detail-copy {
  display: block;
  margin: 22rpx 0 34rpx;
  color: #62707b;
  font-size: 26rpx;
  line-height: 1.6;
}
