page {
  background: #f5f7f4;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
image {
  box-sizing: border-box;
}

.screen {
  min-height: 100vh;
  padding: 36rpx 32rpx 56rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.brand {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.eyebrow {
  display: block;
  margin-top: 8rpx;
  color: #62707b;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.text-button {
  min-width: 0;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #d3dcd7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #17212b;
  font-size: 24rpx;
  line-height: 72rpx;
}

.text-button::after,
.primary-button::after,
.secondary-button::after,
.quantity-button::after,
.danger-button::after {
  border: 0;
}

.hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 36rpx;
  padding: 40rpx;
  border-radius: 8rpx;
  background: #17212b;
  color: #ffffff;
}

.hero::after {
  position: absolute;
  right: 36rpx;
  bottom: -54rpx;
  width: 180rpx;
  height: 180rpx;
  border: 18rpx solid #f2b544;
  border-radius: 50%;
  content: '';
  opacity: 0.9;
}

.hero-title {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 500rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.12;
}

.hero-copy {
  position: relative;
  z-index: 1;
  display: block;
  max-width: 520rpx;
  margin-top: 20rpx;
  color: #d9e3df;
  font-size: 26rpx;
  line-height: 1.55;
}

.section-label {
  display: block;
  margin-bottom: 20rpx;
  color: #62707b;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -1%;
}

.product-card {
  width: 48%;
  margin: 1%;
  overflow: hidden;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 33, 43, 0.07);
}

.product-image {
  display: block;
  width: 100%;
  height: 250rpx;
  padding: 24rpx;
  background: #e7eee9;
}

.product-info {
  padding: 22rpx;
  border-top: 8rpx solid #f2b544;
}

.product-name {
  display: block;
  min-height: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.product-meta {
  display: block;
  margin-top: 10rpx;
  color: #71808a;
  font-size: 22rpx;
}

.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.price {
  color: #17212b;
  font-size: 28rpx;
  font-weight: 700;
}

.small-button {
  min-width: 0;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 6rpx;
  background: #e56b58;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 56rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  width: 100%;
  margin: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 84rpx;
}

.primary-button {
  background: #e56b58;
  color: #ffffff;
}

.secondary-button {
  background: #e7eee9;
  color: #17212b;
}

.danger-button {
  background: transparent;
  color: #b84d3e;
  font-size: 24rpx;
  line-height: 60rpx;
}

.back-link {
  display: block;
  margin-bottom: 28rpx;
  color: #3a63f3;
  font-size: 24rpx;
}

.panel {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #dce5df;
  border-radius: 8rpx;
  background: #ffffff;
}

.panel-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.muted {
  display: block;
  margin-top: 10rpx;
  color: #71808a;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty {
  padding: 100rpx 32rpx;
  color: #71808a;
  text-align: center;
}

.cart-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e5ebe7;
}

.cart-row:last-child {
  border-bottom: 0;
}

.cart-image {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 120rpx;
  padding: 12rpx;
  background: #e7eee9;
}

.cart-details {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.cart-name {
  display: block;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-price {
  display: block;
  margin-top: 8rpx;
  color: #62707b;
  font-size: 22rpx;
}

.quantity {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.quantity-button {
  min-width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d3dcd7;
  border-radius: 6rpx;
  background: #ffffff;
  color: #17212b;
  font-size: 28rpx;
  line-height: 46rpx;
}

.quantity-value {
  min-width: 54rpx;
  color: #17212b;
  font-size: 24rpx;
  text-align: center;
}

.cart-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 28rpx 0;
}

.total-label {
  color: #62707b;
  font-size: 24rpx;
}

.total-value {
  color: #17212b;
  font-size: 40rpx;
  font-weight: 700;
}

.success-mark {
  display: block;
  width: 96rpx;
  height: 96rpx;
  margin: 12rpx auto 24rpx;
  border-radius: 50%;
  background: #b7d8c6;
  color: #1d5b43;
  font-size: 56rpx;
  line-height: 96rpx;
  text-align: center;
}

@media (max-width: 680px) {
  .screen {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
}
