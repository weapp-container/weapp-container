.screen {
  box-sizing: border-box;
  height: 100vh;
  overflow-y: auto;
  padding: 28rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hint {
  display: block;
  color: #526176;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.editor {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  height: 72rpx;
  padding: 14rpx;
  border: 1px solid #b9c7d7;
  border-radius: 8rpx;
  background: #fff;
  color: #172b4d;
  font-size: 28rpx;
}

.multiline {
  height: 160rpx;
}

.actions {
  margin: 24rpx 0;
}

.action {
  min-height: 64rpx;
  margin: 8rpx 0;
  font-size: 24rpx;
  line-height: 2;
}

.status {
  display: block;
  margin: 8rpx 0;
  font-size: 24rpx;
}

.event-log {
  display: block;
  padding: 16rpx;
  border: 1px solid #d6dfe9;
  background: #fff;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
