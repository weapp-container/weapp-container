<view id="page-parent" class="page-probe" data-meta="{{object}}" mark:ancestor="{{object}}" mark:override="{{object}}" style="position:absolute;left:8px;top:16px;width:140px;height:64px" bindtap="onPageParent">
  <view id="page-target" class="page-probe" data-number="{{number}}" data-yes="{{yes}}" data-no="{{no}}" data-nil="{{nil}}" data-text="{{text}}"
      data-object="{{object}}" data-array="{{array}}" data-user-id="{{object}}"
      data-literal-number="42" data-literal-false="false" data-literal-null="null"
      data-literal-json='{"k":1}' data-empty="" data-mixed="v={{number}}"
      mark:number="{{number}}" mark:yes="{{yes}}" mark:no="{{no}}" mark:nil="{{nil}}" mark:text="{{text}}"
      mark:object="{{object}}" mark:array="{{array}}" mark:user-id="{{object}}"
      mark:literal-number="42" mark:literal-false="false" mark:literal-null="null"
      mark:literal-json='{"k":1}' mark:empty="" mark:mixed="v={{number}}" mark:override="{{array}}" mark-source="raw" style="width:140px;height:64px;background:#2468ad" bindtap="onPageTarget" />
</view>
<dataset-probe id="probe" style="position:absolute;left:8px;top:112px;width:304px;height:104px" />
<view id="capture-parent" class="page-probe" data-meta="{{captureMeta}}" mark:ancestor="{{captureMeta}}" mark:override="{{object}}"
  style="position:absolute;left:8px;top:240px;width:304px;height:80px"
  capture-bind:touchend="onCapturePhase"
  bindtouchstart="onCaptureParent" bindtouchend="onCaptureParent" bindtap="onCaptureParent">
  <view id="underlay" style="position:absolute;left:0px;top:0px;width:64px;height:64px;background:#aa3344"
    bindtouchstart="onUnderlay" bindtouchend="onUnderlay" bindtap="onUnderlay" />
  <view id="capture-target" class="page-probe" data-number="{{number}}" data-yes="{{yes}}" data-no="{{no}}" data-nil="{{nil}}" data-text="{{text}}"
      data-object="{{object}}" data-array="{{array}}" data-user-id="{{object}}"
      data-literal-number="42" data-literal-false="false" data-literal-null="null"
      data-literal-json='{"k":1}' data-empty="" data-mixed="v={{number}}"
      mark:number="{{number}}" mark:yes="{{yes}}" mark:no="{{no}}" mark:nil="{{nil}}" mark:text="{{text}}"
      mark:object="{{object}}" mark:array="{{array}}" mark:user-id="{{object}}"
      mark:literal-number="42" mark:literal-false="false" mark:literal-null="null"
      mark:literal-json='{"k":1}' mark:empty="" mark:mixed="v={{number}}" mark:override="{{array}}" mark-source="raw"
    style="position:absolute;left:{{left}}px;top:0px;width:64px;height:64px;background:#22aa66"
    bindtouchstart="onCaptureStart" bindtouchend="onCaptureTarget" bindtap="onCaptureTarget" />
</view>
<view id="page-inspect" style="position:absolute;left:8px;top:368px;width:140px;height:48px;background:#334455" bindtap="onInspect" />
