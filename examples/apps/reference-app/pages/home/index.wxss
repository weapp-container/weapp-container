.screen {
  padding: 48rpx;
}

.card {
  padding: 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.message,
.count {
  display: block;
  margin-top: 24rpx;
}

.button {
  display: block;
  margin-top: 32rpx;
}

.component-slot {
  display: block;
  margin-top: 16rpx;
}
