{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sonofmagic/weapp-container/schemas/container-manifest-v3.schema.json",
  "title": "Weapp Container Portable Manifest with Explicit Renderer Profiles",
  "description": "Renderer requirements are mandatory in schema v3; modern View remains optional.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "compiler",
    "app",
    "routes",
    "modules",
    "templates",
    "styles",
    "components",
    "assets",
    "capabilities",
    "integrity",
    "rendering"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "commit",
        "platform"
      ],
      "properties": {
        "name": {
          "const": "weapp-vite"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "const": "weapp"
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appJson",
        "entryModule"
      ],
      "properties": {
        "appJson": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        "entryModule": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "viewScripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/viewScript"
      }
    },
    "viewCompilation": {
      "$ref": "#/$defs/viewCompilation"
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "styles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(wx\\.[A-Za-z0-9]+(?:\\.[A-Za-z0-9]+)*|(?:Page|Component)\\.[A-Za-z_$][A-Za-z0-9_$]*|object:[A-Za-z_$][A-Za-z0-9_$]*\\.[A-Za-z_$][A-Za-z0-9_$]*|component:[A-Za-z_$][A-Za-z0-9_$]*(?:-[A-Za-z_$][A-Za-z0-9_$]*)*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*(?:-[A-Za-z_$][A-Za-z0-9_$]*)*)*|weappContainer\\.[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*|[A-Za-z_$][A-Za-z0-9_$]*)$"
      },
      "additionalProperties": {
        "enum": [
          "full",
          "partial",
          "unsupported"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "root"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "root": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "modernView": {
      "$ref": "#/$defs/modernView"
    },
    "rendering": {
      "$ref": "#/$defs/rendering"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pointer": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "entryModule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^route:.+"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "enum": [
            "page",
            "tab",
            "subpage"
          ]
        },
        "config": {
          "$ref": "#/$defs/path"
        },
        "entryModule": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "format",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^module:.+"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "format": {
          "enum": [
            "commonjs",
            "esm",
            "json"
          ]
        },
        "scope": {
          "enum": [
            "app",
            "page",
            "component"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^module:.+"
          },
          "uniqueItems": true
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "wxmlAst",
        "bindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^template:.+"
        },
        "wxmlAst": {
          "$ref": "#/$defs/pointer"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "wxsModules": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/wxsAlias"
          },
          "additionalProperties": {
            "$ref": "#/$defs/viewScriptId"
          }
        }
      }
    },
    "wxsAlias": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
      "not": {
        "enum": [
          "break",
          "case",
          "catch",
          "class",
          "const",
          "continue",
          "debugger",
          "default",
          "delete",
          "do",
          "else",
          "enum",
          "export",
          "extends",
          "false",
          "finally",
          "for",
          "function",
          "if",
          "implements",
          "import",
          "in",
          "instanceof",
          "interface",
          "let",
          "new",
          "null",
          "package",
          "private",
          "protected",
          "public",
          "return",
          "static",
          "super",
          "switch",
          "this",
          "throw",
          "true",
          "try",
          "typeof",
          "var",
          "void",
          "while",
          "with",
          "yield",
          "await"
        ]
      }
    },
    "externalWxsId": {
      "type": "string",
      "pattern": "^wxs:(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\#?:\\u0000-\\u001f\\u007f-\\u009f])[^#]*\\.wxs$"
    },
    "viewScriptId": {
      "type": "string",
      "pattern": "^wxs:(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\?:\\u0000-\\u001f\\u007f-\\u009f])(?:[^#]*\\.wxs|[^#]*\\.wxml#[A-Za-z_$][A-Za-z0-9_$]*)$",
      "not": {
        "pattern": "#(?:break|case|catch|class|const|continue|debugger|default|delete|do|else|enum|export|extends|false|finally|for|function|if|implements|import|in|instanceof|interface|let|new|null|package|private|protected|public|return|static|super|switch|this|throw|true|try|typeof|var|void|while|with|yield|await)$"
      }
    },
    "viewScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "dependencies"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/viewScriptId"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalWxsId"
          },
          "uniqueItems": true
        }
      }
    },
    "viewCompilationHelper": {
      "allOf": [
        {
          "$ref": "#/$defs/wxsAlias"
        },
        {
          "type": "string",
          "pattern": "^__wc[A-Za-z0-9_$]*$"
        },
        {
          "not": {
            "enum": [
              "eval",
              "arguments",
              "require",
              "module",
              "exports",
              "undefined",
              "NaN",
              "Infinity",
              "getDate",
              "getRegExp"
            ]
          }
        }
      ]
    },
    "wxmlDocumentId": {
      "type": "string",
      "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\#?:\\u0000-\\u001f\\u007f-\\u009f]).*\\.wxml$"
    },
    "viewCompilation": {
      "description": "Complete versioned executable mapping for every viewScripts module and template; original source hashes and AST pointers remain unchanged. Cross-table identity and unique module/document/expression keys are validated by the runtime.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "version",
        "abi",
        "modules",
        "documents"
      ],
      "properties": {
        "compiler": {
          "const": "weapp-container-wxs"
        },
        "version": {
          "const": "1.0.0"
        },
        "abi": {
          "const": "1.0"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compiledViewModule"
          },
          "uniqueItems": true
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compiledViewDocument"
          },
          "uniqueItems": true
        }
      }
    },
    "compiledViewModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceSha256",
        "executableSha256",
        "helper"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/viewScriptId"
        },
        "sourceSha256": {
          "$ref": "#/$defs/hash"
        },
        "executableSha256": {
          "$ref": "#/$defs/hash"
        },
        "helper": {
          "$ref": "#/$defs/viewCompilationHelper"
        }
      }
    },
    "compiledViewDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "wxmlAst",
        "expressions"
      ],
      "properties": {
        "documentId": {
          "$ref": "#/$defs/wxmlDocumentId"
        },
        "wxmlAst": {
          "$ref": "#/$defs/pointer"
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compiledViewExpression"
          },
          "uniqueItems": true
        }
      }
    },
    "compiledViewExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "shorthand",
        "executableSha256",
        "helper"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "shorthand": {
          "type": "boolean"
        },
        "executableSha256": {
          "$ref": "#/$defs/hash"
        },
        "helper": {
          "$ref": "#/$defs/viewCompilationHelper"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "wxssIr",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^style:.+"
        },
        "wxssIr": {
          "$ref": "#/$defs/pointer"
        },
        "scope": {
          "enum": [
            "app",
            "page",
            "component"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "usingComponents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^components:.+"
        },
        "owner": {
          "$ref": "#/$defs/path"
        },
        "usingComponents": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "multipleSlots": {
          "type": "boolean"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "mime",
        "size"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modernView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "version",
        "abi",
        "target",
        "units"
      ],
      "properties": {
        "compiler": {
          "const": "weapp-container-modern-view"
        },
        "version": {
          "const": "1.0.0"
        },
        "abi": {
          "const": "1.0"
        },
        "target": {
          "const": "es2022"
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modernUnit"
          }
        }
      }
    },
    "modernUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "executableSha256",
        "sourceMapSha256",
        "sources",
        "documents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^modern:[a-f0-9]{64}$"
        },
        "executableSha256": {
          "$ref": "#/$defs/hash"
        },
        "sourceMapSha256": {
          "$ref": "#/$defs/hash"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentId",
              "aliases"
            ],
            "properties": {
              "documentId": {
                "$ref": "#/$defs/wxmlDocumentId"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/wxsAlias"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "rendererProfile": {
      "enum": [
        "skia",
        "webview",
        "skyline-compat"
      ]
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "default",
        "pages"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "default": {
          "$ref": "#/$defs/rendererProfile"
        },
        "pages": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\/$)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\.(?:wxml|json)$)[^\\\\#?:\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/rendererProfile"
          }
        }
      }
    }
  }
}
