<wxs module="tools">
var shared = require('../view/shared.wxs');
var count = 0;
var log = [];
exports.mark = function(label, value) {
  count = count + 1;
  var sample = 'import:' + label + '#' + count + '=' + value + ';shared=' + shared.next();
  log.push(sample);
  return sample;
};
exports.history = function() { return log.join('|'); };
</wxs>
<template name="card">
  <text id="import-headline">{{tools.mark('headline', marker)}}</text>
  <text id="import-history">{{tools.history(marker)}}</text>
</template>
