{
  "name": "@weapp-container/agent",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "AI control plane for building, previewing, testing and uploading mini-program projects",
  "bin": {
    "weapp-container-agent": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown && node scripts/generate-compatibility-baseline.mjs",
    "test": "vitest run",
    "test:dev": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tsdown.config.ts",
    "test:types": "pnpm run tsd",
    "tsd": "pnpm run build && tsd --files test-d/**/*.test-d.ts"
  },
  "dependencies": {
    "@sonofmagic/container-manifest": "workspace:*",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "tsd": "0.33.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/weapp-container/weapp-container/tree/main/tools/container-agent",
  "keywords": [
    "weapp",
    "mini-program",
    "mcp",
    "agent"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-container/weapp-container.git",
    "directory": "tools/container-agent"
  },
  "tsd": {
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "skipLibCheck": true
    }
  }
}
